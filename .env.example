# ==============================================================
# Knotiq Rugs Lead Scraper Bot - Environment Configuration
# NOTE: DO NOT COMMIT REAL SECRETS. Copy to .env and configure.
# ==============================================================

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
APP_SECRET=replace-with-a-secure-random-secret-at-least-32-chars

# Database (Production target is MySQL; sqlite supported for tests/offline dev)
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lead_scraper_db
DB_USER=root
DB_PASS=password
DB_STORAGE=./data/dev.sqlite
DB_LOGGING=false

# Authentication (Clerk)
CLERK_SECRET_KEY=sk_test_placeholder_key_for_clerk_auth
CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key_for_clerk_auth
ENABLE_TEST_AUTH=true

# Google Places API (Tier 1 Source)
GOOGLE_PLACES_API_KEY=

# Google Gemini AI (Enrichment, fit scoring & outreach message drafting)
GEMINI_API_KEY=
GEMINI_DAILY_LIMIT=100

# Scraper Settings
SCRAPER_CONCURRENCY=2
SCRAPER_HEADLESS=true
SCRAPER_PROXY_URL=
DOWNLOAD_SIGNING_SECRET=sign-secret-change-this-in-production-123456

# Notifications & Email (Nodemailer SMTP)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Knotiq Rugs <export@knotiqrugs.com>"

# Meta WhatsApp Cloud API (Graph API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US

# Bulk Send Settings, Security & Anti-Spam
DAILY_LIMIT=50
DELAY_MS=3000
DEFAULT_COUNTRY_CODE=91
BULK_PASSWORD=knotiq2026
DRY_RUN=false

# Compliance & Operational Guardrails
OUTREACH_DAILY_CAP=30
DATA_RETENTION_MONTHS=12
DISK_SPACE_THRESHOLD_MB=500
